From bf166465a40274aed6a64e2a6a5b83a3394de15e Mon Sep 17 00:00:00 2001
From: Julien Jerphanion <git@jjerphan.xyz>
Date: Wed, 6 May 2026 13:12:42 +0200
Subject: [PATCH] maint: Remove `lzma`, `lz4` and `lzo` as dependencies

Signed-off-by: Julien Jerphanion <git@jjerphan.xyz>
---
 libmamba/CMakeLists.txt | 6 ------
 vcpkg.json              | 2 +-
 2 files changed, 1 insertion(+), 7 deletions(-)

diff --git a/libmamba/CMakeLists.txt b/libmamba/CMakeLists.txt
index ef53a772..38598aec 100644
--- a/libmamba/CMakeLists.txt
+++ b/libmamba/CMakeLists.txt
@@ -591,9 +591,6 @@ macro(libmamba_create_target target_name linkage output_name)
             # For Windows we have a vcpkg based build system right now.
             find_package(LibArchive MODULE REQUIRED)
             find_package(CURL CONFIG REQUIRED)
-            find_library(LIBLZMA_LIBRARIES lzma REQUIRED)
-            find_library(LZ4_LIBRARY NAMES lz4)
-            find_library(LZO2_LIBRARY NAMES lzo2)
             find_package(zstd CONFIG REQUIRED)
             find_library(BZIP2_LIBRARIES NAMES bz2)
             find_library(CRYPTO_LIBRARIES NAMES libcrypto)
@@ -613,10 +610,7 @@ macro(libmamba_create_target target_name linkage output_name)
                     ${ICONV_LIBRARY}
                     ${CHARSET_LIBRARY}
                     zstd::libzstd_static
-                    ${LZ4_LIBRARY}
-                    ${LZO2_LIBRARY}
                     ${BZIP2_LIBRARIES}
-                    ${LIBLZMA_LIBRARIES}
                     CURL::libcurl
                     ${sodium_LIBRARY_RELEASE}
             )
diff --git a/vcpkg.json b/vcpkg.json
index 99dce160..cc187f75 100644
--- a/vcpkg.json
+++ b/vcpkg.json
@@ -9,7 +9,7 @@
       "platform": "windows"
     },
     {
-      "features": ["bzip2", "lz4", "lzma", "lzo", "crypto", "zstd"],
+      "features": ["bzip2", "crypto", "zstd"],
       "name": "libarchive"
     },
     {
-- 
2.54.0

